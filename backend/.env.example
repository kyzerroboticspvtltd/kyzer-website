# Copy this file to .env and fill in your values

# Gmail address used to SEND emails
GMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your real password)
# Go to: Google Account → Security → 2-Step Verification → App passwords
# Choose "Mail" + "Other" → name it "Kyzer" → copy the 16-char password
GMAIL_PASS=xxxx xxxx xxxx xxxx

# Email address to RECEIVE notifications (can be same as GMAIL_USER)
NOTIFY_EMAIL=info@kyzerrobotics.com

# Admin password for the admin panel (must match the password you log in with)
ADMIN_PASSWORD=kyzer2024

# Optional: path where site-data.json is stored
# On Railway, set this to your mounted volume path, e.g. /data
# Leave blank to use ./data/ inside the backend folder
DATA_DIR=

# Port (Railway sets this automatically, leave as 3000 for local)
PORT=3000

# ── RAZORPAY ──
# Sign up at https://dashboard.razorpay.com → Settings → API Keys
# Use test keys (rzp_test_...) while testing, live keys (rzp_live_...) for production
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# ── TWILIO SMS (optional — leave blank to disable SMS notifications) ──
# Sign up at https://twilio.com → Get a free trial number
# TWILIO_FROM must be your Twilio number in +1XXXXXXXXXX format
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+1XXXXXXXXXX

# Your WhatsApp/mobile number to receive order SMS alerts (e.g. +919049695264)
NOTIFY_PHONE=+91XXXXXXXXXX
