# Copy this file to .env and fill in your values

# Gmail address used to SEND emails
GMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your real password)
# Go to: Google Account → Security → 2-Step Verification → App passwords
# Choose "Mail" + "Other" → name it "Kyzer" → copy the 16-char password
GMAIL_PASS=xxxx xxxx xxxx xxxx

# Email address to RECEIVE notifications (can be same as GMAIL_USER)
NOTIFY_EMAIL=hello@kyzerrobotics.in

# Admin password for the admin panel (must match the password you log in with)
ADMIN_PASSWORD=kyzer2024

# Optional: path where site-data.json is stored
# On Railway, set this to your mounted volume path, e.g. /data
# Leave blank to use ./data/ inside the backend folder
DATA_DIR=

# Port (Railway sets this automatically, leave as 3000 for local)
PORT=3000
